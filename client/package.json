{
  "name": "@solstack/cli",
  "version": "0.1.0",
  "description": "Solstack client: set up repositories for spec-driven development and connect agents to the Solstack MCP gateway",
  "type": "module",
  "bin": {
    "solstack": "dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fission-ai/openspec": "1.14.1",
    "@inquirer/prompts": "^8.5.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^14.0.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "express": "^5.2.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
