# Public URL of the server. OAuth callbacks and links are built from it.
# Local development (Vite dev server): http://localhost:5173
BASE_URL=http://localhost:5173

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Encrypts integration secrets and developer tokens at rest. Losing it means everyone reconnects.
ENCRYPTION_KEY=

DATABASE_URL=postgres://solstack:solstack@localhost:5432/solstack
POSTGRES_PASSWORD=solstack

PORT=3000
# Set to 1 when running behind a single reverse proxy (Caddy, nginx) that terminates HTTPS.
TRUST_PROXY=0
